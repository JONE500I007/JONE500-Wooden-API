{
	"schemaVersion": 1,
	"id": "jone500_wooden_api",
	"version": "${version}",
	"name": "Wooden API",
	"description": "A library that makes it easy for modders to add signs, hanging signs, boats, chest boats and shelves for their own wood types, with datagen helpers.",
	"authors": [
		"JONE500"
	],
	"license": "CC0-1.0",
	"icon": "assets/jone500_wooden_api/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.wooden.api.WoodenApi"
		],
		"client": [
			"net.wooden.api.client.WoodenApiClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~1.21.9",
		"java": ">=21",
		"fabric-api": "*"
	},
	"custom": {
		"modmenu": {
			"badges": ["library"]
		}
	}
